<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Oh My Cards{% endblock %}</title>
    <link rel="icon" href="{{ asset('assets/favicon/favicon.ico') }}">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {#    Bootstrap #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    {#    Icône de Bootstrap #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    {#    Page CSS du site #}
    <link rel="stylesheet" href="{{ asset('assets/styles/app.css') }}">
</head>
<body>
<header>
    {#    Popper + Javascript de Bootstrap #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    <style>@import url('https://fonts.googleapis.com/css2?family=Irish+Grover&display=swap');</style>
    <nav id="navbar" class="navbar sticky-top navbar-expand-lg bg-light">
        <div class="container">
            <a class="navbar-brand mx-auto order-lg-1" href="{{ path('app_accueil') }}">
                <img src="{{ asset('assets/images/logo/ohMyCards.png') }}" alt="Oh My Cards" width="140" height="80">
            </a>

            <!-- Menu burger pour petits écrans -->
            <button class="navbar-toggler order-lg-0" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarContenu"
                    aria-controls="navbarContenu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div id="navbarContenu" class="collapse navbar-collapse justify-content-center order-lg-2">
                <ul class="navbar-nav text-center">
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="{{ path('app_accueil') }}">Accueil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page"
                           href="{{ path('app_produits') }}">Produits</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="{{ path('app_contact') }}">Contact</a>
                    </li>
                </ul>
            </div>

            <div class="d-flex align-items-center justify-content-end order-lg-3">
{#              Formulaire avec le titre de la recherche renseigné => requête POST vers la page produits #}
                <form class="d-none d-lg-flex me-3" role="search" action="/produits" method="post">
                    <input
                            class="form-control"
                            id="search"
                            type="text"
                            name="recherche"
                            placeholder="🔎 Recherche"
                            value="{{ app.request.query.post('reponse')|default('') }}"
                    />
                </form>

                <a class="nav-link active" style="font-size: 170%;" href="{{ path('app_panier_index') }}">🛒</a>
                <div class="dropdown">
                    <button class="btn" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                            style="font-size: 170%;">
                        ‍🙍‍♂️
                    </button>
                    <ul class="dropdown-menu">
                        <li>
                            <button class="dropdown-item" type="button">
                                <a class="nav-link active" href="{{ path('app_login') }}">Connexion</a>
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" type="button">
                                <a class="nav-link active" href="{{ path('app_register') }}">Inscription</a>
                            </button>
                        </li>
                    </ul>
                </div>
                {% if is_granted('ROLE_USER') %}
                <a class="nav-link active" style="font-size: 170%;" href="{{ path('app_reglages_2') }}">⚙️</a>
                {% endif %}
            </div>
        </div>
    </nav>
</header>

{% block body %}{% endblock %}

<footer>
    <div class="footer-container">
        <div class="footer-logo-social">
            <div class="footer-logo">
                <img src="{{ asset('assets/images/logo/ohMyCards.png') }}" alt="Oh My Cards">
            </div>
            <div class="footer-social">
                <a href="https://www.facebook.com/" target="_blank"><img
                            src="{{ asset('assets/images/logo/facebook.png') }}" alt="Facebook"></a>
                <a href="https://www.instagram.com/" target="_blank"><img
                            src="{{ asset('assets/images/logo/instagram.png') }}" alt="Instagram"></a>
                <a href="https://pinterest.com/" target="_blank"><img
                            src="{{ asset('assets/images/logo/pinterest.png') }}" alt="Pinterest"></a>
                <a href="https://www.tiktok.com/" target="_blank"><img
                            src="{{ asset('assets/images/logo/tik-tok.png') }}" alt="TikTok"></a>
            </div>
        </div>
        <div class="footer-info">
            <h6>Informations</h6>
            <ul>
                <li><a href="{{ path('app_faq') }}">FAQ</a></li>
                <li><a href="{{ path('app_mentions_legales') }}">Mentions légales</a></li>
                <li><a href="{{ path('app_donnees_personnelles') }}">Données personnelles</a></li>
                <li><a href="{{ path('app_CGDV') }}">Conditions générales de ventes</a></li>
            </ul>
        </div>
        <div class="footer-newsletter">
            <h6>Newsletter</h6>
            <p>Inscrivez-vous pour ne rien louper !</p>
            <form>
                <input type="email" placeholder="Votre adresse e-mail">
                <button type="submit">→</button>
            </form>
        </div>
    </div>
</footer>
</body>
</html>
