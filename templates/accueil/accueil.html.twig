{% extends 'base.html.twig' %}

{% block body %}
    <div class="container-principale">
        <div class="texte-et-images">
            <div class="texte-bienvenue">
                <h2>Bienvenue sur</h2>
                <h1 style="color: black">Oh My Cards !</h1>
                <h2>
                    Votre destination incontournable pour toutes vos cartes favorites : que vous soyez fan de cartes à
                    collectionner comme Hello Kitty, Yu-Gi-Oh!, ou que vous recherchiez des cartes au design unique et
                    original, vous êtes au bon endroit ! Nous sélectionnons pour vous les meilleurs produits, aux
                    meilleurs prix, en alliant qualité et passion.
                </h2>
            </div>

            <div class="images-section">
                <img src="{{ asset('assets/images/illustrations/homme.png') }}" alt="Homme avec un air affirmé"
                     class="image-homme">
                <img src="{{ asset('assets/images/illustrations/bulle.png') }}"
                     alt="Découvrez, collectionnez, et faites briller votre passion avec Oh My Cards !"
                     class="image-bulle">
            </div>
        </div>

        <div class="container-pointillés">
            <div id="carouselExampleIndicators" class="carousel slide" data-bs-theme="dark">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0"
                            class="active"
                            aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1"
                            aria-label="Slide 2"></button>
                    <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2"
                            aria-label="Slide 3"></button>
                    <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="3"
                            aria-label="Slide 4"></button>
                </div>
                <div class="carousel-inner">
                    <a href="{{ path('app_produits', {themeu: "Classique"}) }}">
                        <div class="carousel-item active">
                            <img src="{{ asset('assets/images/illustrations/classique.png') }}" class="d-block w-100"
                                 alt="Sélection cartes classiques">
                        </div>
                    </a>
                    <a href="{{ path('app_produits', {themeu: "Hello Kitty"}) }}">
                        <div class="carousel-item">
                            <img src="{{ asset('assets/images/illustrations/hello-kitty.png') }}" class="d-block w-100"
                                 alt="Sélection cartes hello-kitty">
                        </div>
                    </a>
                    <a href="{{ path('app_produits', {themeu: "Yu-gi-oh"}) }}">
                        <div class="carousel-item">
                            <img src="{{ asset('assets/images/illustrations/yu-gi-oh.png') }}" class="d-block w-100"
                                 alt="Sélection cartes yu-gi-oh">
                        </div>
                    </a>
                    <a href="{{ path('app_produits', {themeu: "pokemon"}) }}">
                        <div class="carousel-item">
                            <img src="{{ asset('assets/images/illustrations/pokemon.png') }}" class="d-block w-100"
                                 alt="Sélection cartes pokemon">
                        </div>
                    </a>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators"
                        data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators"
                        data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </div>

        <div class="btn-container">
            <a href="{{ path('app_produits') }}"><button class="btn-découvrir">Découvrir</button></a>
        </div>
    </div>
{% endblock %}
